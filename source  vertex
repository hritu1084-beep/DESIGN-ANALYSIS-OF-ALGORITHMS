#include <stdio.h>
#include <stdlib.h>

int n;
int visited[100];
int head[100], to[10000], next[10000];
int edgeCount = 0;

void addEdge(int u, int v) {
    to[edgeCount] = v;
    next[edgeCount] = head[u];
    head[u] = edgeCount++;
}

void DFS(int v) {
    visited[v] = 1;

    for (int e = head[v]; e != -1; e = next[e]) {
        int u = to[e];

        if (visited[u] == 0)
            DFS(u);
    }
}

int findSource() {
    int candidate = -1;

    // Step 1: Find candidate
    for (int i = 0; i < n; i++)
        visited[i] = 0;

    for (int v = 0; v < n; v++) {
        if (visited[v] == 0) {
            DFS(v);
            candidate = v;
        }
    }

    // Step 2: Reset visited array
    for (int i = 0; i < n; i++)
        visited[i] = 0;

    // Step 3: Verify candidate
    if (candidate == -1)
        return -1;

    DFS(candidate);

    for (int v = 0; v < n; v++) {
        if (visited[v] == 0)
            return -1;
    }

    return candidate;
}

int main() {
    int m, u, v;

    printf("Enter number of vertices and edges: ");
    scanf("%d %d", &n, &m);

    if (n < 1 || n > 100 || m < 0 || m > 10000) {
        printf("Invalid graph size\n");
        return 1;
    }

    for (int i = 0; i < n; i++)
        head[i] = -1;

    printf("Enter directed edges (u v):\n");

    for (int i = 0; i < m; i++) {
        scanf("%d %d", &u, &v);

        if (u < 0 || u >= n || v < 0 || v >= n) {
            printf("Invalid edge\n");
            return 1;
        }

        addEdge(u, v);
    }

    int result = findSource();

    if (result == -1)
        printf("No source vertex exists\n");
    else
        printf("Source vertex is %d\n", result);

    return 0;
}
