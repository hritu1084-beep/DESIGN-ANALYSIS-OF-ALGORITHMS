#include <stdio.h>

int a[20][20], visited[20], stack[20];
int top = -1, n;

void DFS(int v) {
    visited[v] = 1;

    for (int i = 0; i < n; i++) {
        if (a[v][i] == 1 && visited[i] == 0) {
            DFS(i);
        }
    }

    stack[++top] = v;
}

void topologicalSort() {
    for (int i = 0; i < n; i++) {
        visited[i] = 0;
    }

    for (int i = 0; i < n; i++) {
        if (visited[i] == 0) {
            DFS(i);
        }
    }

    printf("Topological Order: ");

    while (top != -1) {
        printf("%d ", stack[top--]);
    }
}

int main() {
    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    topologicalSort();

    return 0;
}
