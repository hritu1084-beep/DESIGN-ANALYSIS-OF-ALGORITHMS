#include <stdio.h>

int majorityElement(int a[], int n) {
    int candidate = 0, count = 0;

    // Step 1: Find candidate
    for (int i = 0; i < n; i++) {
        if (count == 0) {
            candidate = a[i];
            count = 1;
        }
        else if (a[i] == candidate)
            count++;
        else
            count--;
    }

    // Step 2: Verify candidate
    count = 0;

    for (int i = 0; i < n; i++) {
        if (a[i] == candidate)
            count++;
    }

    if (count > n / 2)
        return candidate;
    else
        return -1;
}

int main() {
    int a[100], n, result;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++)
        scanf("%d", &a[i]);

    result = majorityElement(a, n);

    if (result == -1)
        printf("No majority element");
    else
        printf("Majority element = %d", result);

    return 0;
}
